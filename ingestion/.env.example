# Copy to .env (gitignored) and adjust. Matches docker-compose.yml defaults.
DATABASE_URL=postgresql://crewops:crewops@localhost:5433/crewops

# "local" (default) = fastembed, offline, no API key, 384-dim BAAI/bge-small-en-v1.5.
# "openai" = requires OPENAI_API_KEY below; truncated to 384-dim via the API's
# `dimensions` param so it still fits the vector(384) columns unchanged.
EMBEDDING_PROVIDER=local

# only used if EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
